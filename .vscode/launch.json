{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Object Tracking Engine (MSVC x64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_vs/Debug/ObjectTrackingEngine.exe",
            "args": ["${workspaceFolder}/Video.mp4"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/opencv/build/x64/vc16/bin;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: Build MSVC x64 Debug"
        }
    ]
}
